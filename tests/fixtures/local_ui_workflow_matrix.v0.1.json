{
  "schema": "motionjson.local_ui_workflow_matrix.v0.1",
  "description": "Matrix of local UI workflow paths, generated run configs, backend validation expectations, model planner behavior, review tools, and export surfaces.",
  "caseStatusLegend": {
    "runnable": "Runs in the default local test environment without GPU, model weights, credentials, or hosted network calls.",
    "blocked": "Intentionally blocked by validation/readiness with a user-actionable message.",
    "conditional": "Can validate or run when optional CPU-safe dependencies/capabilities are available; tests use controlled capability reports.",
    "mocked": "Validated with mocked provider/model readiness; no real hosted/GPU/model call is required."
  },
  "cases": [
    {
      "id": "trace_one_mock_prompt",
      "title": "Trace one object with mock/no-model provider",
      "status": "runnable",
      "goal": "trace_one_object",
      "uiPreset": "trace_one_object",
      "modelConnectionId": "mock",
      "providerName": "mock",
      "discoveryMode": "manual_prompt",
      "builderInput": {
        "presetId": "trace_one_object",
        "maskProvider": "mock",
        "debugMockMode": true,
        "prompts": [{"kind": "positive_point", "x": 24, "y": 24, "frameIndex": 0}],
        "sampleFps": 6,
        "maxFrames": 2
      },
      "capabilityReport": {
        "providers": [
          {"name": "mock", "kind": "mask_provider", "available": true, "runnable": true, "status": "ready", "noModelSafe": true},
          {"name": "manual_prompt", "kind": "discovery_provider", "available": true, "runnable": true, "status": "ready", "noModelSafe": true}
        ]
      },
      "expectedRunConfig": {
        "provider.name": "mock",
        "discovery.mode": "manual_prompt",
        "prompts.0.kind": "positive_point",
        "sampling.sample_fps": 6,
        "sampling.max_frames": 2,
        "provider.sam2.hosted_allow_network": false,
        "provider.sam3.hosted_allow_network": false
      },
      "expectedValidation": {
        "valid": true,
        "errorCodes": [],
        "warningCodes": []
      },
      "expectedJob": {
        "uiCanStart": true,
        "canRunInDefaultTests": true,
        "terminalStatus": "succeeded"
      },
      "expectedArtifacts": {
        "kindsAnyOf": ["scene_graph", "object_manifest", "candidate_summary", "track_summary", "web_manifest"]
      },
      "expectedReview": {
        "readyForReview": true,
        "reviewToolsReady": true,
        "hasTracksOrDiagnostics": true
      },
      "expectedExport": {
        "validationOk": true,
        "formatsAnyOf": ["motionjson"],
        "kindsAnyOf": ["validated_motionjson_scene", "final_export_manifest", "motionjson_export_zip"]
      }
    },
