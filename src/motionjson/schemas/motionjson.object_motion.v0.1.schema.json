{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motionjson.object_motion.v0.1",
  "title": "MotionJSON Object Motion v0.1",
  "type": "object",
  "required": ["schema", "objectId", "fps", "motion", "quality", "recommendedOutput"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "motionjson.object_motion.v0.1" },
    "objectId": { "$ref": "#/$defs/nonEmptyString" },
    "fps": { "$ref": "#/$defs/nonNegativeNumber" },
    "motion": {
      "type": "array",
      "items": { "$ref": "#/$defs/motionFrame" }
    },
    "quality": { "$ref": "#/$defs/quality" },
    "recommendedOutput": { "$ref": "#/$defs/recommendedOutput" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "zeroToOne": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "numberPair": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "spriteFrame": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 }
      }
    },
    "motionFrame": {
      "type": "object",
      "required": [
        "frame",
        "sourceFrameIndex",
        "t",
        "visible",
        "x",
        "y",
        "w",
        "h",
        "scale",
        "rotation",
        "opacity",
        "anchor",
        "asset",
        "mask",
        "centroid"
      ],
      "additionalProperties": false,
      "properties": {
        "frame": { "type": "integer", "minimum": 1 },
        "sourceFrameIndex": { "type": "integer", "minimum": 0 },
        "t": { "$ref": "#/$defs/nonNegativeNumber" },
        "visible": { "type": "boolean" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "scale": { "type": "number" },
        "rotation": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0 },
        "anchor": { "$ref": "#/$defs/numberPair" },
        "asset": { "type": ["string", "null"] },
        "mask": { "$ref": "#/$defs/nonEmptyString" },
        "centroid": { "anyOf": [{ "$ref": "#/$defs/numberPair" }, { "type": "null" }] },
        "sprite": { "$ref": "#/$defs/spriteFrame" }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "maskStability",
        "edgeComplexity",
        "bboxStability",
        "maskDriftScore",
        "edgeQualityScore",
        "missingFrameScore",
        "occlusionRiskScore",
        "vectorSuitability",
        "productionReadinessScore",
        "visibleFrameRatio",
        "missingFrameRatio",
        "longestMissingFrameRun",
        "productionReadiness",
        "routingReasons"
      ],
      "additionalProperties": true,
      "properties": {
        "maskStability": { "$ref": "#/$defs/zeroToOne" },
        "edgeComplexity": { "$ref": "#/$defs/zeroToOne" },
        "bboxStability": { "$ref": "#/$defs/zeroToOne" },
        "maskDriftScore": { "$ref": "#/$defs/zeroToOne" },
        "edgeQualityScore": { "$ref": "#/$defs/zeroToOne" },
        "missingFrameScore": { "$ref": "#/$defs/zeroToOne" },
        "occlusionRiskScore": { "$ref": "#/$defs/zeroToOne" },
        "vectorSuitability": { "$ref": "#/$defs/zeroToOne" },
        "productionReadinessScore": { "$ref": "#/$defs/zeroToOne" },
        "visibleFrameRatio": { "$ref": "#/$defs/zeroToOne" },
        "missingFrameRatio": { "$ref": "#/$defs/zeroToOne" },
        "longestMissingFrameRun": { "type": "integer", "minimum": 0 },
        "productionReadiness": { "type": "string", "enum": ["ready", "review", "needs_correction"] },
        "routingReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommendedOutput": {
      "type": "string",
      "enum": ["raster_alpha_sequence", "hybrid_vector_silhouette_plus_raster"]
    }
  }
}
