{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motionjson.final_export_manifest.v0.1",
  "title": "MotionJSON Final Export Manifest v0.1",
  "type": "object",
  "required": ["schema", "version", "aiUsage", "source", "exports", "rights", "notes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "motionjson.final_export_manifest.v0.1" },
    "version": { "type": "string", "minLength": 1 },
    "aiUsage": { "const": "none" },
    "source": {
      "type": "object",
      "required": ["sceneGraph", "directory", "objectId", "width", "height", "fps", "frameCount"],
      "additionalProperties": false,
      "properties": {
        "sceneGraph": { "type": "string", "minLength": 1 },
        "directory": { "type": "string", "minLength": 1 },
        "objectId": { "type": ["string", "null"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "minimum": 0 },
        "frameCount": { "type": "integer", "minimum": 0 }
      }
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exportEntry" }
    },
    "rights": {
      "type": "object",
      "additionalProperties": true
    },
    "rightsManifest": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "app": { "const": "motionjson" },
        "version": { "type": "string" },
        "sourceJobId": { "type": ["string", "null"] },
        "sourceAssetId": { "type": ["string", "null"] },
        "exportId": { "type": "string" },
        "exportPreset": { "type": "string" },
        "correctionEventCount": { "type": "integer", "minimum": 0 },
        "aiUsage": { "const": "none" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    },
    "qualityRouting": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "format": { "const": "motionjson.export_quality_routing.v0.1" },
        "aiUsage": { "const": "none" },
        "source": { "type": "string" },
        "objects": { "type": "array" },
        "preview": { "type": "object" }
      }
    },
    "exportWarnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string" },
          "objectId": { "type": "string" },
          "message": { "type": "string" },
          "suggestedAction": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ok": { "type": "boolean" },
        "checked": { "type": "integer", "minimum": 0 },
        "issueCount": { "type": "integer", "minimum": 0 }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "exportEntry": {
      "type": "object",
      "required": ["type", "format", "status", "mimeType", "path", "bytes", "aiUsage", "source"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["ready", "plan_ready", "not_configured", "skipped", "unavailable", "unsupported", "error"]
        },
        "mimeType": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "aiUsage": { "const": "none" },
        "source": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "minimum": 0 },
        "frameCount": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" }
      }
    }
  }
}
