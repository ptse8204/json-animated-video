{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motionjson.object_manifest.v0.1",
  "title": "MotionJSON Object Manifest v0.1",
  "type": "object",
  "required": [
    "schema",
    "objectId",
    "label",
    "renderMode",
    "cutouts",
    "masks",
    "spritesheet",
    "motion",
    "quality",
    "recommendedOutput"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "motionjson.object_manifest.v0.1" },
    "objectId": { "$ref": "#/$defs/nonEmptyString" },
    "label": { "$ref": "#/$defs/nonEmptyString" },
    "renderMode": { "const": "raster_alpha_sequence" },
    "cutouts": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "masks": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "spritesheet": { "$ref": "#/$defs/spritesheet" },
    "production": { "$ref": "#/$defs/productionAssets" },
    "motion": {
      "type": "array",
      "items": { "$ref": "#/$defs/motionFrame" }
    },
    "quality": { "$ref": "#/$defs/quality" },
    "recommendedOutput": { "$ref": "#/$defs/recommendedOutput" },
    "rights": { "$ref": "#/$defs/rightsBlockCompat" },
    "discovery": { "$ref": "#/$defs/discoveryMetadata" },
    "exportStatus": { "$ref": "#/$defs/exportStatus" },
    "exportIncluded": { "type": "boolean" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "zeroToOne": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "numberPair": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "spriteFrame": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 }
      }
    },
    "spritesheet": {
      "type": ["object", "null"],
      "required": ["path", "width", "height", "columns", "rows", "cellWidth", "cellHeight", "frames"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 0 },
        "cellWidth": { "type": "integer", "minimum": 0 },
        "cellHeight": { "type": "integer", "minimum": 0 },
        "frames": {
          "type": "array",
          "items": { "$ref": "#/$defs/spriteFrame" }
        }
      }
    },
    "productionAssets": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "motionFrame": {
      "type": "object",
      "required": [
        "frame",
        "sourceFrameIndex",
        "t",
        "visible",
        "x",
        "y",
        "w",
        "h",
        "scale",
        "rotation",
        "opacity",
        "anchor",
        "asset",
        "mask",
        "centroid"
      ],
      "additionalProperties": false,
      "properties": {
        "frame": { "type": "integer", "minimum": 1 },
        "sourceFrameIndex": { "type": "integer", "minimum": 0 },
        "t": { "$ref": "#/$defs/nonNegativeNumber" },
        "visible": { "type": "boolean" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 },
        "scale": { "type": "number" },
        "rotation": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0 },
        "anchor": { "$ref": "#/$defs/numberPair" },
        "asset": { "type": ["string", "null"] },
        "mask": { "$ref": "#/$defs/nonEmptyString" },
        "centroid": { "anyOf": [{ "$ref": "#/$defs/numberPair" }, { "type": "null" }] },
        "sprite": { "$ref": "#/$defs/spriteFrame" }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "maskStability",
        "edgeComplexity",
        "bboxStability",
        "maskDriftScore",
        "edgeQualityScore",
        "missingFrameScore",
        "occlusionRiskScore",
        "vectorSuitability",
        "productionReadinessScore",
        "visibleFrameRatio",
        "missingFrameRatio",
        "longestMissingFrameRun",
        "productionReadiness",
        "routingReasons"
      ],
      "additionalProperties": true,
      "properties": {
        "maskStability": { "$ref": "#/$defs/zeroToOne" },
        "edgeComplexity": { "$ref": "#/$defs/zeroToOne" },
        "bboxStability": { "$ref": "#/$defs/zeroToOne" },
        "maskDriftScore": { "$ref": "#/$defs/zeroToOne" },
        "edgeQualityScore": { "$ref": "#/$defs/zeroToOne" },
        "missingFrameScore": { "$ref": "#/$defs/zeroToOne" },
        "occlusionRiskScore": { "$ref": "#/$defs/zeroToOne" },
        "vectorSuitability": { "$ref": "#/$defs/zeroToOne" },
        "productionReadinessScore": { "$ref": "#/$defs/zeroToOne" },
        "visibleFrameRatio": { "$ref": "#/$defs/zeroToOne" },
        "missingFrameRatio": { "$ref": "#/$defs/zeroToOne" },
        "longestMissingFrameRun": { "type": "integer", "minimum": 0 },
        "productionReadiness": { "type": "string", "enum": ["ready", "review", "needs_correction"] },
        "routingReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommendedOutput": {
      "type": "string",
      "enum": ["raster_alpha_sequence", "hybrid_vector_silhouette_plus_raster"]
    },
    "exportStatus": {
      "type": "string",
      "enum": ["accepted", "review_pending", "rejected", "excluded", "deleted", "merged", "failed", "fallback_raster"]
    },
    "discoveryMetadata": {
      "type": "object",
      "required": ["candidateId", "source", "providerName", "reviewStatus", "selectedForTracking", "trackConfidence", "motionCoverage", "reviewRequired", "exportStatus"],
      "additionalProperties": true,
      "properties": {
        "candidateId": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "providerName": { "type": ["string", "null"] },
        "providerModel": { "type": ["string", "null"] },
        "qualityPreset": { "type": ["string", "null"] },
        "candidateScore": { "anyOf": [{ "$ref": "#/$defs/zeroToOne" }, { "type": "null" }] },
        "stabilityScore": { "anyOf": [{ "$ref": "#/$defs/zeroToOne" }, { "type": "null" }] },
        "motionScore": { "anyOf": [{ "$ref": "#/$defs/zeroToOne" }, { "type": "null" }] },
        "frameCoverageEstimate": { "anyOf": [{ "$ref": "#/$defs/zeroToOne" }, { "type": "null" }] },
        "reviewStatus": {
          "type": "string",
          "enum": ["pending", "selected", "ignored", "rejected", "accepted", "excluded", "review_pending", "unknown"]
        },
        "rejectionReason": { "type": ["string", "null"] },
        "selectedForTracking": { "type": "boolean" },
        "defaultSelected": { "type": "boolean" },
        "trackConfidence": { "anyOf": [{ "$ref": "#/$defs/zeroToOne" }, { "type": "null" }] },
        "motionCoverage": { "$ref": "#/$defs/zeroToOne" },
        "reviewRequired": { "type": "boolean" },
        "exportStatus": { "$ref": "#/$defs/exportStatus" },
        "trackingProvider": { "type": ["string", "null"] },
        "correctionHistoryRef": { "type": ["string", "null"] },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "filters": {
          "type": "object",
          "additionalProperties": true
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maskDir": { "type": "string" },
            "thumbnailArtifactPath": { "type": "string" },
            "maskPreviewArtifactPath": { "type": "string" },
            "thumbnailArtifactId": { "type": "string" },
            "maskPreviewArtifactId": { "type": "string" }
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "rightsBlockCompat": {
      "anyOf": [
        { "$ref": "#/$defs/rightsBlock" },
        { "$ref": "#/$defs/legacyRightsBlock" }
      ]
    },
    "legacyRightsBlock": {
      "type": "object",
      "required": ["sourceAttribution", "license"],
      "additionalProperties": true,
      "properties": {
        "sourceAttribution": {
          "anyOf": [
            { "type": "boolean" },
            { "$ref": "#/$defs/sourceAttribution" }
          ]
        },
        "license": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "rightsBlock": {
      "type": "object",
      "required": ["sourceAttribution", "license", "licenseDetails", "creatorApproval", "commercialUse", "commercialUseStatus", "assetLineage", "auditLog"],
      "additionalProperties": false,
      "properties": {
        "sourceAttribution": { "$ref": "#/$defs/sourceAttribution" },
        "license": { "$ref": "#/$defs/nonEmptyString" },
        "licenseDetails": { "$ref": "#/$defs/licenseDetails" },
        "creatorApproval": { "$ref": "#/$defs/creatorApproval" },
        "commercialUse": { "type": "boolean" },
        "commercialUseStatus": { "type": "string", "enum": ["approved", "review_required", "restricted", "rejected", "unverified"] },
        "assetLineage": { "$ref": "#/$defs/assetLineage" },
        "auditLog": { "$ref": "#/$defs/auditLog" }
      }
    },
    "sourceAttribution": {
      "type": "object",
      "required": ["required", "sourceType", "sourceAssetId", "sourceUri", "displayText"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "sourceType": { "$ref": "#/$defs/nonEmptyString" },
        "sourceAssetId": { "type": ["string", "null"] },
        "sourceUri": { "type": "string" },
        "displayText": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "licenseDetails": {
      "type": "object",
      "required": ["name", "url", "scope"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "type": ["string", "null"] },
        "scope": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "creatorApproval": {
      "type": "object",
      "required": ["approved", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "approved": { "type": "boolean" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "assetLineage": {
      "type": "object",
      "required": ["origin", "operations"],
      "additionalProperties": false,
      "properties": {
        "origin": { "$ref": "#/$defs/nonEmptyString" },
        "operations": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "auditLog": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  }
}
