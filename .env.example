# Local backend deployment defaults. Leave values empty unless explicitly used.
MOTIONJSON_BACKEND_DB=.motionjson/backend.sqlite
MOTIONJSON_STORAGE_ROOT=.motionjson/storage
MOTIONJSON_API_HOST=127.0.0.1
MOTIONJSON_API_PORT=8765
MOTIONJSON_DEFAULT_PLAN=starter

# Provider selection stays explicit and swappable.
SEGMENTATION_BACKEND=threshold
SAM2_LOCAL_CHECKPOINT=
SAM2_LOCAL_CONFIG=
SAM2_LOCAL_DEVICE=cpu
HOSTED_SEGMENTATION_URL=
HOSTED_SEGMENTATION_API_KEY=

# Optional LLM/VLM routing for labeling or optimization, not pixel segmentation.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_DEFAULT_MODEL=
LLM_API_KEY=

# Storage/export defaults are local and do not require managed cloud services.
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_PREFIX=
EXPORT_BACKEND=local
